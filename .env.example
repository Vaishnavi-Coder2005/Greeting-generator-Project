# Copy this file to ".env" and adjust the values.

# Port the app runs on (http://localhost:3000)
PORT=3000

# Where the printed QR code should send people.
# The QR itself always encodes  https://<your-domain>/go
# and /go redirects here. "/" = the language-selection screen (first step).
QR_TARGET=/

# Your live website address (used to pre-fill the QR generator at /#/qr)
PUBLIC_URL=http://localhost:3000
